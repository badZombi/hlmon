[Unit]
Description=Homelab Monitor Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/homelab-monitor/server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
User=homelab
Group=homelab

Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
